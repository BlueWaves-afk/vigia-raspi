# Copy this file to deploy/.env and fill in real values before `docker compose up`

# Required: PostgreSQL admin password
POSTGRES_PASSWORD=change_me_strong_password

# Optional: Cosmos 3 API key (leave blank to run in stub/demo mode)
COSMOS3_API_KEY=

# Optional: override merge radius (metres) for hazard spatial clustering
HAZARD_MERGE_RADIUS_M=5

# Optional: server CN used in Mosquitto TLS cert (defaults to vigia-broker)
VIGIA_SERVER_CN=vigia-broker

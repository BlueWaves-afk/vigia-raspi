[Unit]
Description=VIGIA ADAS DePIN Edge Node
Documentation=https://github.com/VigiaLabs/vigia-raspi
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root

# Phase 5: SIM7600 ECM bearer init runs before the edge node starts.
# Script is non-fatal — node starts even if LTE is unavailable.
ExecStartPre=/usr/local/bin/vigia-sim7600-init.sh

# MQTT broker IP for routing (set via /etc/vigia/env or override here)
EnvironmentFile=-/etc/vigia/env

# Allow SCHED_FIFO for RT threads (AntiDeathNode at priority 99)
AmbientCapabilities=CAP_SYS_NICE CAP_IPC_LOCK
CapabilityBoundingSet=CAP_SYS_NICE CAP_IPC_LOCK

# mlockall() for RT latency — keep shm and stack resident in RAM
LimitMEMLOCK=infinity
LimitRTPRIO=99
LimitNOFILE=65536

# Systemd watchdog — AntiDeathNode pings every 10s; kill+restart if missed.
WatchdogSec=30s
NotifyAccess=main

# Disable swap — /dev/shm frame buffer (829 MB) must never be evicted.
MemorySwapMax=0

# Source ROS2 and workspace, then launch
ExecStart=/bin/bash -c '\
  source /home/vigiasense/ros2_jazzy/install/setup.bash && \
  source /home/vigiasense/vigia-raspi/vigia_ws/install/setup.bash && \
  exec /home/vigiasense/vigia-raspi/vigia_ws/install/vigia_edge_node/lib/vigia_edge_node/vigia_edge_node \
    --ros-args \
    --params-file /home/vigiasense/vigia-raspi/vigia_ws/install/vigia_edge_node/share/vigia_edge_node/config/camera_params.yaml \
    --params-file /home/vigiasense/vigia-raspi/vigia_ws/install/vigia_edge_node/share/vigia_edge_node/config/vision_params.yaml \
    --params-file /home/vigiasense/vigia-raspi/vigia_ws/install/vigia_edge_node/share/vigia_edge_node/config/depth_params.yaml \
    --params-file /home/vigiasense/vigia-raspi/vigia_ws/install/vigia_edge_node/share/vigia_edge_node/config/fusion_params.yaml \
    --params-file /home/vigiasense/vigia-raspi/vigia_ws/install/vigia_edge_node/share/vigia_edge_node/config/sensor_bridge_params.yaml \
    --params-file /home/vigiasense/vigia-raspi/vigia_ws/install/vigia_edge_node/share/vigia_edge_node/config/ble_gatt_params.yaml \
    --params-file /home/vigiasense/vigia-raspi/vigia_ws/install/vigia_edge_node/share/vigia_edge_node/config/anti_death_params.yaml'

# Restart on crash — not on clean exit (e.g. AntiDeathNode initiated shutdown)
Restart=on-failure
RestartSec=3s

# Give the process up to 20s to shut down cleanly (15s power window + margin)
TimeoutStopSec=20s

# Prevent OOM killer from hitting the edge node (it holds /dev/shm frame buffer)
OOMScoreAdjust=-900

# Log to journal
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vigia-edge

[Install]
WantedBy=multi-user.target
